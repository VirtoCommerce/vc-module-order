<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <noWarn>1591</noWarn>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!--This line is necessary to copy all dependencies in the bin folder-->
    <!--<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Compile Remove="node_modules\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <EmbeddedResource Remove="node_modules\**" />
    <None Remove="dist\**" />
    <None Remove="node_modules\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NSwag emits repeated request/response plumbing; regenerate these clients instead of refactoring them.
         They stay project items so this project-level setting reaches them. -->
    <None Include="vue\src\api_client\virtocommerce.*.ts" />
    <SonarQubeSetting Include="sonar.cpd.exclusions">
      <Value>**/vue/src/api_client/virtocommerce.*.ts</Value>
    </SonarQubeSetting>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DinkToPdfCopy" Version="1.0.0" />
    <PackageReference Include="VirtoCommerce.NotificationsModule.TemplateLoader.FileSystem" Version="3.1018.0" />
    <PackageReference Include="VirtoCommerce.PaymentModule.Data" Version="3.1010.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.OrdersModule.Core\VirtoCommerce.OrdersModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.OrdersModule.Data.MySql\VirtoCommerce.OrdersModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.OrdersModule.Data.PostgreSql\VirtoCommerce.OrdersModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.OrdersModule.Data.SqlServer\VirtoCommerce.OrdersModule.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.OrdersModule.Data\VirtoCommerce.OrdersModule.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\blades\addresses\" />
    <NotificationTemplates Include="NotificationTemplates\**" />
    <Folder Include="Properties\" />
  </ItemGroup>
  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(NotificationTemplates)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
  <!-- Admin Shell plugin: built from vue/ into plugins/admin-shell/ before publish, so vc-build Compress (locally and in CI)
       packs it, as VirtoCommerce.SalesRep builds its storefront plugin. SkipAdminShellPlugin=true leaves it out. -->
  <Target Name="BuildAdminShellPlugin" BeforeTargets="Publish" Condition="'$(SkipAdminShellPlugin)' != 'true' AND Exists('$(MSBuildProjectDirectory)\vue\package.json')">
    <Exec Command="corepack enable" ContinueOnError="true" />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn type-check" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn build" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
  </Target>
  <!-- The platform probes {moduleRoot}/plugins/, but publish goes to {moduleRoot}/bin. The files are listed here, after the
       build: listed when the project loads, a clean checkout (no plugins/ yet) would copy nothing. -->
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish" DependsOnTargets="BuildAdminShellPlugin" Condition="'$(SkipAdminShellPlugin)' != 'true'">
    <ItemGroup>
      <AdminShellPlugin Include="$(MSBuildProjectDirectory)\plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\plugins\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>
</Project>